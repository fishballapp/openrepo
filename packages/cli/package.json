{
  "name": "@openrepo/cli",
  "version": "0.1.3",
  "type": "module",
  "description": "Open up your repo: eject a standalone workspace from a private monorepo.",
  "license": "MIT",
  "homepage": "https://github.com/fishballapp/openrepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/openrepo.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "openrepo": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm --dts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stricli/core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "bin": {
      "openrepo": "./dist/cli.mjs"
    }
  }
}
