{
  "name": "@openrepo/plugin-local-leaks",
  "version": "0.2.0",
  "type": "module",
  "description": "openrepo plugin: stop an eject that would publish a local path or a .env file.",
  "license": "MIT",
  "homepage": "https://github.com/fishballapp/openrepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishballapp/openrepo.git",
    "directory": "packages/plugin-local-leaks"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@openrepo/cli": "workspace:^"
  },
  "devDependencies": {
    "@openrepo/cli": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
